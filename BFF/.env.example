# Copy this file to .env (gitignored) and fill in your Choreo values.
# These credentials stay server-side — unlike the client's VITE_* vars, they
# are never shipped to the browser.

# Choreo-exposed getToken API (absolute URL).
CHOREO_TOKEN_URL=https://<your-org-id>-<env>.e1-us-east-azure.choreoapis.dev/pipeline/python-server/v1.0/getToken

# Choreo OAuth2 token endpoint — same gateway host as the API. Copy it from the
# Developer Portal → your application → Credentials → Application Keys pane.
CHOREO_TOKEN_ENDPOINT=https://<your-org-id>-<env>.e1-us-east-azure.choreoapis.dev/oauth2/token

# Application Consumer Key/Secret from the same Application Keys pane.
CHOREO_CONSUMER_KEY=<your-application-consumer-key>
CHOREO_CONSUMER_SECRET=<your-application-consumer-secret>

# Port the BFF listens on (8006 is the local token server, so default is 8007).
# PORT=8007

# Comma-separated CORS origins allowed to call the BFF. Defaults to "*"; pin it
# to your frontend(s) in production.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
