# LiveKit connection (required)
LIVEKIT_URL=wss://your-livekit-instance
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Default room handed out when the client does not specify one
LIVEKIT_ROOM=voice-room

# Explicit-dispatch agent placed into the room via the token's room config.
# Must match the agent_name the voice-agent worker registers with.
LIVEKIT_AGENT_NAME=voice-agent

# Token lifetime in seconds (maps to the JWT exp claim). Overridable per
# request via ?ttl=. Default 3600 (1h); the LiveKit SDK's own default is 6h.
LIVEKIT_TOKEN_TTL=3600

# Seconds LiveKit keeps an empty room alive before closing it. Overridable per
# request via ?emptyTimeout=. Default 300 (5 min).
LIVEKIT_EMPTY_TIMEOUT=300

# Comma-separated CORS origins allowed to call /getToken. "*" allows any origin
# (dev only — a wildcard cannot safely carry credentials). Pin to your
# frontend(s) in production, e.g.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
