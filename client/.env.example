# Copy this file to .env (gitignored) or .env.local and fill in your Choreo
# values.
#
# Reminder: VITE_* vars are embedded into the built client bundle and are
# visible to anyone who loads the page. The consumer secret below is exposed to
# browsers — only use credentials scoped to what a public client may do, or move
# the token exchange to a backend for a hardened setup.

# --- Dev proxy origin (used only by `vite dev`, see vite.config.ts) -----------

# Choreo gateway origin — proxied under /choreo (strips the prefix). This same
# host serves BOTH the OAuth2 token endpoint and the API, so one proxy covers
# both.
VITE_CHOREO_ORIGIN=https://<your-org-id>-<env>.e1-us-east-azure.choreoapis.dev

# --- getToken API endpoint ----------------------------------------------------

# Full URL, or a dev-proxy path routed through /choreo (no browser CORS in dev).
# The proxy strips /choreo, so this maps to <VITE_CHOREO_ORIGIN>/.../getToken
VITE_TOKEN_URL=/choreo/pipeline/python-server/v1.0/getToken

# --- OAuth2 client-credentials (Consumer Key + Consumer Secret) ---------------
# The client POSTs these to the gateway's token endpoint to obtain a short-lived
# bearer token, then calls getToken with `Authorization: Bearer <token>`.
# Copy the Consumer Key, Consumer Secret and Token Endpoint from the Choreo
# Developer Portal → your application → Credentials → Application Keys pane.

# Token endpoint. It lives on the SAME gateway host as the API, so in dev use
# the dev-proxy path (routes via /choreo → <VITE_CHOREO_ORIGIN>/oauth2/token).
# In prod use the absolute Token Endpoint shown in the Application Keys pane,
# e.g. https://<your-org-id>-<env>.e1-us-east-azure.choreoapis.dev/oauth2/token
VITE_TOKEN_ENDPOINT=/choreo/oauth2/token

VITE_CONSUMER_KEY=<your-application-consumer-key>
VITE_CONSUMER_SECRET=<your-application-consumer-secret>

# --- Legacy fallback (optional) -----------------------------------------------
# Used only when VITE_CONSUMER_KEY/SECRET are unset: a pre-generated static API
# key sent as a header instead of the OAuth2 bearer token.
# VITE_TOKEN_API_KEY=<your-choreo-api-key>
# VITE_TOKEN_API_KEY_HEADER=api-key
