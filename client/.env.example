# Copy this file to .env (gitignored) and adjust if needed.
#
# The client holds no secrets: the Choreo OAuth2 exchange (consumer key/secret)
# happens inside the BFF (see BFF/.env.example), and the LiveKit server URL
# arrives in the BFF's getToken response — neither is stored client-side.

# Full URL of the BFF getToken endpoint.
VITE_TOKEN_URL=http://localhost:8007/getToken
