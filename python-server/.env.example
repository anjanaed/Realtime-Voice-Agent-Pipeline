# OpenAI API Key (Required for STT/TTS)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Ballerina LLM Service (Required for conversation logic)
LLM_SERVICE_URL=ws://localhost:8003/llm

# LiveKit Connection (Required)
LIVEKIT_URL=wss://your-livekit-instance
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM=voice-room
AGENT_IDENTITY=python-agent

# Token server config (the token server runs in-process with the agent worker)
# Explicit-dispatch agent placed into the room via the token's room config.
# Must match the agent_name the voice-agent worker registers with.
LIVEKIT_AGENT_NAME=voice-agent
# Token lifetime in seconds (JWT exp). Overridable per request via ?ttl=. Default 1h.
LIVEKIT_TOKEN_TTL=3600
# Seconds an empty room stays alive before LiveKit closes it. Overridable via ?emptyTimeout=.
LIVEKIT_EMPTY_TIMEOUT=300
# Comma-separated CORS origins allowed to call /getToken. "*" = any (dev only).
# Pin to your frontend(s) in production, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
